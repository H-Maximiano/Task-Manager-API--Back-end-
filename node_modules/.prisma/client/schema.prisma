generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Usuario {
  id      Int      @id @default(autoincrement())
  email   String   @unique
  senha   String
  tarefas Tarefa[]
}

model Tarefa {
  id        Int    @id @default(autoincrement())
  nome      String
  concluida Int    @default(0)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}
